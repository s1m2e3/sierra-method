@dc:title "System Ports"
@dc:description "Description of component ports for the Mission Control system."
description <https://fireforce6.github.io/mission-control/system-analysis/ports#> as ports {
    uses <http://purl.org/dc/elements/1.1/> as dc
    extends <https://fireforce6.github.io/mission-control/system-analysis/components#> as components
    extends <https://fireforce6.github.io/mission-control/operational-analysis/items#> as items
    uses <https://www.modelware.io/sierra/component#> as component
    extends <https://fireforce6.github.io/mission-control/system-analysis/connections#> as connections

    instance VisualCamera.Data_Out : component:Port [
        component:portOf components:VisualCamera
        component:direction "Out"
    ]

    instance VisualCamera.Power_In : component:Port [
        component:portOf components:VisualCamera
        component:direction "In"
    ]

    instance ThermalSensor.Data_Out : component:Port [
        component:portOf components:ThermalSensor
        component:direction "Out"
    ]

    relation instance Connection1 : component:Connection [
        from VisualCamera.Data_Out
        to connections:Payload.Data_Out
    ]
}
